// KDCC Darpan data model (first version).
// Conventions: all DateTime values are UTC. Schedules are evaluated in Asia/Kolkata.
// Text is UTF-8 (Gujarati safe). Media display names are stored separately from storage keys.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum UserRole {
  SUPER_ADMIN
  HO_ADMIN
  REGION_MANAGER
  BRANCH_VIEWER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  UPLOADED // original stored, waiting for processing
  PROCESSING // Sharp / FFmpeg job running
  READY // processed file available for screens
  FAILED
}

enum Orientation {
  LANDSCAPE
  PORTRAIT
}

enum ScreenStatus {
  PENDING // registered, waiting to be paired
  ONLINE
  OFFLINE
}

enum AssignmentTarget {
  SCREEN
  BRANCH
  TALUKA
  REGION
  ALL
}

enum CommandStatus {
  PENDING
  SENT
  ACKED
  FAILED
}

// ───────────────────────── Hierarchy ─────────────────────────

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  talukas      Taluka[]
  managers     User[]
  assignments  Assignment[]
  displayHours DisplayHours[]
  broadcasts   Broadcast[]
}

model Taluka {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  regionId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region       Region         @relation(fields: [regionId], references: [id])
  branches     Branch[]
  assignments  Assignment[]
  displayHours DisplayHours[]
  broadcasts   Broadcast[]

  @@unique([regionId, name])
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String?  @unique // bank's own branch code
  name      String
  address   String?
  talukaId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taluka       Taluka         @relation(fields: [talukaId], references: [id])
  screens      Screen[]
  viewers      User[]
  assignments  Assignment[]
  displayHours DisplayHours[]
  broadcasts   Broadcast[]
}

model Screen {
  id          String       @id @default(uuid()) @db.Uuid
  name        String?
  branchId    String?      @db.Uuid // null until paired
  orientation Orientation  @default(LANDSCAPE)
  status      ScreenStatus @default(PENDING)

  // Pairing / auth
  hardwareId      String    @unique
  deviceTokenHash String    @unique // argon2 or sha256 of the token; never the raw token
  pairingCode     String?   @unique // 6 digits while unpaired
  pairingExpires  DateTime?
  pairedAt        DateTime?

  // Device info (updated by register + heartbeat)
  model           String?
  osVersion       String?
  appVersion      String?
  resolution      String?
  storageFreeMb   Int?
  storageTotalMb  Int?
  ramFreeMb       Int?
  ramTotalMb      Int?
  currentMediaId  String?   @db.Uuid
  manifestVersion String?
  kioskState      String? // off | locked | maintenance, from the heartbeat
  appVersionCode  Int? // from the heartbeat; compared with releases
  updateStatus    String? // the TV's last word on an app update, e.g. "Failed: ..."
  testUpdates     Boolean   @default(false) // gets app releases in the TEST stage
  kioskUntil      DateTime? // maintenance ends
  broadcastId     String?   @db.Uuid // the broadcast the TV says it is showing (no FK: it may be deleted)
  broadcastStatus String? // playing | loading | error: ..., from the heartbeat
  lastSeenAt      DateTime?
  ipAddress       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch?         @relation(fields: [branchId], references: [id])
  currentMedia Media?          @relation("ScreenCurrentMedia", fields: [currentMediaId], references: [id], onDelete: SetNull)
  assignments  Assignment[]
  displayHours DisplayHours[]
  broadcasts   Broadcast[]
  commands     DeviceCommand[]
  playLogs     PlayLog[]
  playDays     PlayDaily[]
  alerts       ScreenAlert[]

  @@index([branchId])
  @@index([status])
}

// ───────────────────────── Content ─────────────────────────

model Media {
  id           String      @id @default(uuid()) @db.Uuid
  originalName String // exactly as uploaded (may be Gujarati)
  displayName  String // clean name shown in dashboard
  type         MediaType
  status       MediaStatus @default(UPLOADED)

  // Original upload, kept for re-processing. Keys are ASCII-safe (never the user's file name).
  originalKey       String @unique
  originalSha256    String // used to detect the same file uploaded twice
  originalSizeBytes BigInt
  originalMimeType  String

  // Processed file the TVs download. Null until processing finishes.
  storageKey String? @unique
  mimeType   String?
  sizeBytes  BigInt?
  sha256     String? // TVs verify every download against this
  thumbKey   String? // small WebP preview for the dashboard

  width        Int?
  height       Int?
  durationSec  Int? // videos: real length; images: null (use playlist default)
  startDate    DateTime? // ad goes live
  endDate      DateTime? // ad expiry
  tags         String[]
  errorMessage String?

  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy     User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  playlistItems  PlaylistItem[]
  playLogs       PlayLog[]
  playDays       PlayDaily[]
  playingScreens Screen[]       @relation("ScreenCurrentMedia")
  broadcasts     Broadcast[]

  @@index([status])
  @@index([endDate])
  @@index([originalSha256])
}

model Playlist {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  defaultImageSec Int      @default(10)
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       PlaylistItem[]
  assignments Assignment[]
}

model PlaylistItem {
  id          String @id @default(uuid()) @db.Uuid
  playlistId  String @db.Uuid
  mediaId     String @db.Uuid
  position    Int
  durationSec Int? // override; null = media duration (video) or playlist default (image)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([playlistId, position])
}

model Assignment {
  id         String           @id @default(uuid()) @db.Uuid
  playlistId String           @db.Uuid
  targetType AssignmentTarget
  screenId   String?          @db.Uuid
  branchId   String?          @db.Uuid
  talukaId   String?          @db.Uuid
  regionId   String?          @db.Uuid
  priority   Int              @default(0) // higher wins (screen > branch > taluka > region > all by default)
  createdAt  DateTime         @default(now())

  playlist  Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  screen    Screen?    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  taluka    Taluka?    @relation(fields: [talukaId], references: [id], onDelete: Cascade)
  region    Region?    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  schedules Schedule[]

  @@index([screenId])
  @@index([branchId])
}

// Dayparting for an assignment. No schedule rows = always on.
model Schedule {
  id           String    @id @default(uuid()) @db.Uuid
  assignmentId String    @db.Uuid
  daysOfWeek   Int[] // 0 = Sunday … 6 = Saturday (Asia/Kolkata); empty = every day
  startTime    String? // "HH:mm" local; null = from midnight
  endTime      String? // "HH:mm" local; null = to midnight. Earlier than startTime = runs past midnight
  startDate    DateTime? @db.Date // first day (local calendar date)
  endDate      DateTime? @db.Date // last day, inclusive

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

/// When screens are switched on. Closest level wins, like playlists: screen > branch > taluka > region > all.
/// Outside these hours the TV shows a black screen and stops playing.
model DisplayHours {
  id              String           @id @default(uuid()) @db.Uuid
  targetType      AssignmentTarget
  screenId        String?          @db.Uuid
  branchId        String?          @db.Uuid
  talukaId        String?          @db.Uuid
  regionId        String?          @db.Uuid
  daysOfWeek      Int[] // days the screen is on (0 = Sunday)
  onTime          String // "HH:mm" local
  offTime         String // "HH:mm" local
  closedSaturdays Int[] // e.g. [2, 4]: 2nd and 4th Saturday off (bank holidays)
  brightness      Int? // percent while on (10-100); null = leave the TV's own setting
  updatedAt       DateTime         @updatedAt

  screen Screen? @relation(fields: [screenId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  taluka Taluka? @relation(fields: [talukaId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([targetType])
}

// ───────────────────────── Users & audit ─────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  name              String
  passwordHash      String
  role              UserRole  @default(BRANCH_VIEWER)
  isActive          Boolean   @default(true)
  totpSecret        String? // AES-256-GCM encrypted with TOTP_ENCRYPTION_KEY
  totpEnabled       Boolean   @default(false)
  totpLastStep      Int? // last accepted 30-second step, so a code cannot be used twice
  recoveryCodes     String[]  @default([]) // SHA-256 of unused one-time recovery codes
  lastLoginAt       DateTime?
  passwordChangedAt DateTime? // sessions issued before this are refused
  regionId          String?   @db.Uuid // scope for REGION_MANAGER
  branchId          String?   @db.Uuid // scope for BRANCH_VIEWER
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  region            Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  branch            Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  media             Media[]
  playlists         Playlist[]
  auditLogs         AuditLog[]
  commands          DeviceCommand[]
  releases          AppRelease[]
  broadcastsStarted Broadcast[]     @relation("BroadcastStartedBy")
  broadcastsEnded   Broadcast[]     @relation("BroadcastEndedBy")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String // e.g. "media.upload", "playlist.update", "screen.claim"
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────────────── Devices ─────────────────────────

model PlayLog {
  id         BigInt   @id @default(autoincrement())
  screenId   String   @db.Uuid
  mediaId    String   @db.Uuid
  startedAt  DateTime
  durationMs Int
  receivedAt DateTime @default(now())

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([screenId, mediaId, startedAt]) // de-duplicate re-sent batches
  @@index([startedAt])
}

/// Proof of play per screen, ad and India date. Filled as play logs arrive; reports read this,
/// not PlayLog (raw rows are pruned after 90 days). Names are copied in so the record survives
/// a deleted screen or ad.
model PlayDaily {
  id         BigInt   @id @default(autoincrement())
  day        DateTime @db.Date // date in Asia/Kolkata
  screenId   String?  @db.Uuid
  mediaId    String?  @db.Uuid
  screenName String
  branchName String?
  mediaName  String
  plays      Int
  durationMs BigInt
  updatedAt  DateTime @updatedAt

  screen Screen? @relation(fields: [screenId], references: [id], onDelete: SetNull)
  media  Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([day, screenId, mediaId])
  @@index([mediaId, day])
  @@index([screenId, day])
}

model DeviceCommand {
  id          String        @id @default(uuid()) @db.Uuid
  screenId    String        @db.Uuid
  type        String // restart | reload | screenshot | clearCache | kioskUnlock | kioskLock | emergency:show | emergency:clear
  params      Json?
  status      CommandStatus @default(PENDING)
  result      Json?
  issuedById  String?       @db.Uuid
  createdAt   DateTime      @default(now())
  sentAt      DateTime?
  completedAt DateTime?

  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  issuedBy User?  @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([screenId, status])
}

/// Where a TV app version is offered. Test screens first, then every screen.
enum ReleaseStage {
  TEST // only screens marked for test updates
  ALL // every screen
  STOPPED // offered to none (a bad build); TVs already on it keep it
}

/// A TV app build uploaded on the dashboard. TVs in kiosk mode install the newest one offered to them.
model AppRelease {
  id           String       @id @default(uuid()) @db.Uuid
  versionCode  Int          @unique
  versionName  String
  storageKey   String
  sha256       String
  sizeBytes    BigInt
  notes        String?
  stage        ReleaseStage @default(TEST)
  uploadedById String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

/// Offline-alert settings (one row, id 1). Times are India time.
model AlertSettings {
  id              Int      @id @default(1)
  enabled         Boolean  @default(true)
  offlineAfterMin Int      @default(15)
  recipients      String[]
  /// For screens without display hours: only alert inside this window.
  daysOfWeek      Int[]    @default([1, 2, 3, 4, 5, 6])
  onTime          String   @default("10:00")
  offTime         String   @default("17:30")
  closedSaturdays Int[]    @default([2, 4])
  updatedAt       DateTime @updatedAt
}

/// One stretch of a screen being offline. Open while resolvedAt is null.
model ScreenAlert {
  id           String    @id @default(uuid()) @db.Uuid
  screenId     String    @db.Uuid
  offlineSince DateTime
  /// When the email went out; null while outside the hours the screen should be on.
  notifiedAt   DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@index([screenId, resolvedAt])
  @@index([resolvedAt])
}

// ───────────────────────── Broadcasts ─────────────────────────

enum BroadcastKind {
  MESSAGE // text only
  MEDIA // an image or video from the media library
  LINK // a live stream or video link: YouTube, or a direct .m3u8 / .mp4 address
}

/// Takes over the chosen screens until stopped or until endsAt. The newest one that applies wins.
model Broadcast {
  id          String           @id @default(uuid()) @db.Uuid
  kind        BroadcastKind
  title       String? // short heading, e.g. "Live: Prime Minister's address"
  message     String? // full text for MESSAGE; a caption strip for MEDIA and LINK
  mediaId     String?          @db.Uuid
  url         String?
  youtubeId   String? // set when url is a YouTube video
  muted       Boolean          @default(false)
  targetType  AssignmentTarget
  screenId    String?          @db.Uuid
  branchId    String?          @db.Uuid
  talukaId    String?          @db.Uuid
  regionId    String?          @db.Uuid
  startedAt   DateTime         @default(now())
  endsAt      DateTime? // stops by itself then; null = until stopped
  endedAt     DateTime? // stopped from the dashboard
  startedById String?          @db.Uuid
  endedById   String?          @db.Uuid

  media     Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  screen    Screen? @relation(fields: [screenId], references: [id], onDelete: Cascade)
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  taluka    Taluka? @relation(fields: [talukaId], references: [id], onDelete: Cascade)
  region    Region? @relation(fields: [regionId], references: [id], onDelete: Cascade)
  startedBy User?   @relation("BroadcastStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  endedBy   User?   @relation("BroadcastEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([endedAt, startedAt])
}
