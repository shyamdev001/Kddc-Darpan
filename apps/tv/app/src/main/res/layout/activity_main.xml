<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- What the branch sees. Rotated as a whole for portrait-mounted TVs. -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/imageA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/imageB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:resize_mode="fit"
            app:shutter_background_color="@android:color/black"
            app:use_controller="false" />

        <!-- Paired, but nothing playable yet -->
        <LinearLayout
            android:id="@+id/idlePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ink"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_gu"
                android:textColor="#FFFFFF"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/idleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/idle_message"
                android:textColor="@color/muted"
                android:textSize="18sp" />

            <!-- Why nothing plays, so head office can tell from a photo of the screen -->
            <TextView
                android:id="@+id/idleDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- First start: show the pairing code -->
    <LinearLayout
        android:id="@+id/pairPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="12dp"
                android:background="@color/haldi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/pair_title"
            android:textColor="@color/muted"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/pairCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/code_bg"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:paddingStart="40dp"
            android:paddingTop="12dp"
            android:paddingEnd="40dp"
            android:paddingBottom="12dp"
            android:text="@string/pair_waiting"
            android:textColor="#FFFFFF"
            android:textSize="88sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:maxWidth="560dp"
            android:text="@string/pair_hint"
            android:textColor="@color/mist"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/pairStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/changeServer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/button_bg"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/change_server"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Server address, typed with the remote -->
    <LinearLayout
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/setup_hint"
            android:textColor="@color/muted"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/input_bg"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_bg"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/setup_connect"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/setupMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:maxWidth="560dp"
            android:textColor="@color/haldi"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
