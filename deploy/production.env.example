# Production settings. Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Generate each secret with:  openssl rand -hex 32

# The dashboard's address. Point its DNS A record at the server first; Caddy then gets the certificate.
DARPAN_DOMAIN=signage.example.com

# Database password (letters and digits only, so it fits in the connection address).
POSTGRES_PASSWORD=

# The address the TVs use. Same domain, always https.
PUBLIC_BASE_URL=https://signage.example.com
WEB_ORIGIN=https://signage.example.com

# Sign-in sessions. Long random string.
JWT_SECRET=
SESSION_TTL_HOURS=12

# 2FA: encrypts authenticator secrets. Generate with:  openssl rand -base64 32
# Keep a copy somewhere safe: losing it means everyone sets up 2FA again.
TOTP_ENCRYPTION_KEY=
REQUIRE_2FA=admins

# First SUPER_ADMIN, created once with:  docker compose exec api npx prisma db seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Head Office Admin

# Upload limits (MB).
MEDIA_MAX_IMAGE_MB=30
MEDIA_MAX_VIDEO_MB=500

# Offline alert emails.
MAIL_DRIVER=console
MAIL_FROM="KDCC Darpan <no-reply@example.com>"
