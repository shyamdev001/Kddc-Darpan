# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (local PostgreSQL 18) ---
# Replace YOUR_PASSWORD with the postgres password you set during install.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/darpan?schema=public"

# --- API server ---
# 0.0.0.0 so the TV on the LAN / hotspot can reach the laptop.
API_HOST=0.0.0.0
API_PORT=4000
# Public base URL the TV uses to download media (use your laptop's LAN IP).
PUBLIC_BASE_URL=http://192.168.1.10:4000
# Dashboard origin allowed by CORS.
WEB_ORIGIN=http://localhost:3000

# --- Auth ---
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
SESSION_TTL_HOURS=12

# First SUPER_ADMIN created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@kdcc.local
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_NAME=Head Office Admin

# --- Storage ---
# local (dev) or s3 (prod, Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=D:/kdcc-data/media

# --- Media processing ---
# Leave blank if ffmpeg/ffprobe are on PATH; otherwise e.g. C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=
MEDIA_MAX_IMAGE_MB=30
MEDIA_MAX_VIDEO_MB=500

# Used only when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:4000
